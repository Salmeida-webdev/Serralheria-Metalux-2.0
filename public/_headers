/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self'; form-action 'self' https://wa.me; object-src 'none'; base-uri 'self'; frame-ancestors 'none'
  Cache-Control: no-cache

/assets/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

